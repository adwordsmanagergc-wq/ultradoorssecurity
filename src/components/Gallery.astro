---
import { CATEGORIES, type Project } from '../data/portfolio';

interface Props {
  projects: Project[];
  id?: string;
  masonry?: boolean;
}
const { projects, id = 'gallery', masonry = false } = Astro.props;

// Only show filter buttons for categories that actually have images.
const present = new Set(projects.map((p) => p.category));
const filters = CATEGORIES.filter((c) => c === 'All' || present.has(c));
---
<div id={id} class="gallery">
  <!-- Filter buttons -->
  <div class="flex flex-wrap justify-center gap-2" role="group" aria-label="Filter projects by category">
    {
      filters.map((cat, i) => (
        <button
          type="button"
          class="filter-btn rounded-full border-2 px-4 py-2 text-sm font-bold transition-colors"
          data-filter={cat}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))
    }
  </div>

  <!-- Grid -->
  <div
    class={`gallery-grid mt-8 ${
      masonry
        ? 'columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4'
        : 'grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4'
    }`}
  >
    {
      projects.map((p, i) => (
        <figure
          class="gallery-item group relative cursor-pointer overflow-hidden rounded-2xl bg-panel shadow-card break-inside-avoid"
          data-category={p.category}
          data-index={i}
        >
          <img
            src={p.src}
            alt={p.alt}
            loading="lazy"
            decoding="async"
            width="600"
            height="450"
            class={`w-full object-cover transition-transform duration-500 group-hover:scale-105 ${masonry ? '' : 'aspect-square h-full'}`}
          />
          <span class="pointer-events-none absolute inset-0 flex items-end bg-gradient-to-t from-ink/70 via-transparent to-transparent p-3 opacity-0 transition-opacity group-hover:opacity-100">
            <span class="text-xs font-semibold text-white">{p.category}</span>
          </span>
          <button type="button" class="absolute inset-0 h-full w-full" aria-label={`View: ${p.alt}`} data-lightbox={i}></button>
        </figure>
      ))
    }
  </div>

  <p class="empty-msg mt-8 hidden text-center text-[#3a4b5f]">
    No projects in this category yet.
  </p>
</div>

<!-- Lightbox dialog -->
<div
  class="lightbox fixed inset-0 z-[60] hidden items-center justify-center bg-ink/92 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Project image viewer"
  data-gallery={id}
>
  <button type="button" class="lb-close absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label="Close">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button type="button" class="lb-prev absolute left-4 grid h-11 w-11 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label="Previous image">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <button type="button" class="lb-next absolute right-4 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label="Next image">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
  </button>
  <figure class="max-h-[88vh] max-w-5xl">
    <img class="lb-img mx-auto max-h-[80vh] w-auto rounded-lg" src="" alt="" />
    <figcaption class="lb-cap mt-3 text-center text-sm text-white/80"></figcaption>
  </figure>
</div>

<script is:inline define:vars={{ galleryId: id }}>
  (function () {
    var root = document.getElementById(galleryId);
    if (!root) return;
    var items = Array.prototype.slice.call(root.querySelectorAll('.gallery-item'));
    var btns = root.querySelectorAll('.filter-btn');
    var emptyMsg = root.querySelector('.empty-msg');
    var lightbox = document.querySelector('.lightbox[data-gallery="' + galleryId + '"]');
    var lbImg = lightbox.querySelector('.lb-img');
    var lbCap = lightbox.querySelector('.lb-cap');
    var current = -1;
    var lastFocus = null;

    function activeItems() {
      return items.filter(function (el) {
        return el.style.display !== 'none';
      });
    }

    // Filtering
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var f = btn.getAttribute('data-filter');
        btns.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        var shown = 0;
        items.forEach(function (el) {
          var match = f === 'All' || el.getAttribute('data-category') === f;
          el.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        if (emptyMsg) emptyMsg.classList.toggle('hidden', shown > 0);
      });
    });

    // Lightbox
    function open(el) {
      var img = el.querySelector('img');
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lbCap.textContent = img.alt;
      var act = activeItems();
      current = act.indexOf(el);
      lastFocus = document.activeElement;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      lightbox.querySelector('.lb-close').focus();
    }
    function close() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      if (lastFocus) lastFocus.focus();
    }
    function step(dir) {
      var act = activeItems();
      if (!act.length) return;
      current = (current + dir + act.length) % act.length;
      var img = act[current].querySelector('img');
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lbCap.textContent = img.alt;
    }

    items.forEach(function (el) {
      el.querySelector('[data-lightbox]').addEventListener('click', function () { open(el); });
    });
    lightbox.querySelector('.lb-close').addEventListener('click', close);
    lightbox.querySelector('.lb-prev').addEventListener('click', function () { step(-1); });
    lightbox.querySelector('.lb-next').addEventListener('click', function () { step(1); });
    lightbox.addEventListener('click', function (e) { if (e.target === lightbox) close(); });
    window.addEventListener('keydown', function (e) {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  })();
</script>

<style>
  .filter-btn {
    border-color: var(--panel);
    color: var(--navy);
    background: #fff;
  }
  .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
  .filter-btn[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>
