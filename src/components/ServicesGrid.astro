---
import ServiceCard from './ServiceCard.astro';
import { services } from '../data/services';
---
<section id="services" class="bg-cream py-20 sm:py-24">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center reveal">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Our services</h2>
      <p class="mt-4 text-lg text-[#3a4b5f]">
        From bespoke security doors to industrial shutters and 24/7 emergency
        repairs — one experienced team for homes and businesses across the
        North West.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <div class="reveal" style={`transition-delay:${(i % 3) * 80}ms`}>
            <ServiceCard service={service} />
          </div>
        ))
      }
    </div>
  </div>
</section>
