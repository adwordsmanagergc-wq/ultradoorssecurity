---
/**
 * Animated entrance: ornate wrought-iron mansion gates carrying the brand
 * emblem, which swing open on page load to reveal the site.
 *
 * Driven entirely by CSS animation, so it plays even if JavaScript is off and
 * can never trap the visitor: the final keyframe sets the overlay to
 * visibility:hidden and pointer-events:none. A prefers-reduced-motion rule
 * removes it for anyone who opts out of motion.
 */

// Bar positions across a 360-wide leaf (symmetric, so both leaves share art).
const bars = [55, 105, 155, 205, 255, 305];
// A spearhead finial path centred on x, tip at yTip.
const finial = (x: number) =>
  `M${x - 7} 78 L${x} 40 L${x + 7} 78 Z`;
---
<div class="gate-intro" aria-hidden="true">
  <div class="gate-stage">
    <div class="gate-leaf gate-leaf--left">
      <svg viewBox="0 0 360 900" preserveAspectRatio="xMidYMin slice" width="100%" height="100%">
        <defs>
          <linearGradient id="iron" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#04060b" />
            <stop offset="0.5" stop-color="#1a2233" />
            <stop offset="1" stop-color="#04060b" />
          </linearGradient>
          <linearGradient id="gold" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f6dc93" />
            <stop offset="0.5" stop-color="#d7a53f" />
            <stop offset="1" stop-color="#9c6f22" />
          </linearGradient>
        </defs>
        <!-- outer frame -->
        <rect x="6" y="8" width="16" height="884" fill="url(#iron)" />
        <rect x="338" y="8" width="16" height="884" fill="url(#iron)" />
        <rect x="6" y="112" width="348" height="14" fill="url(#iron)" />
        <rect x="6" y="700" width="348" height="14" fill="url(#iron)" />
        <rect x="6" y="360" width="348" height="10" fill="url(#iron)" />
        <!-- vertical bars + gold finials -->
        {bars.map((x) => (
          <g>
            <rect x={x - 2.5} y="70" width="5" height="822" fill="url(#iron)" />
            <path d={finial(x)} fill="url(#gold)" />
            <circle cx={x} cy="86" r="4.5" fill="url(#gold)" />
          </g>
        ))}
        <!-- wrought-iron diamond + ring motif in the lower panel -->
        <g fill="none" stroke="url(#gold)" stroke-width="4" opacity="0.92">
          <path d="M180 452 L236 520 L180 588 L124 520 Z" />
          <circle cx="180" cy="520" r="15" />
          <path d="M180 126 v40 M180 646 v40" stroke-width="3" />
        </g>
      </svg>
    </div>

    <div class="gate-leaf gate-leaf--right">
      <svg viewBox="0 0 360 900" preserveAspectRatio="xMidYMin slice" width="100%" height="100%">
        <rect x="6" y="8" width="16" height="884" fill="url(#iron)" />
        <rect x="338" y="8" width="16" height="884" fill="url(#iron)" />
        <rect x="6" y="112" width="348" height="14" fill="url(#iron)" />
        <rect x="6" y="700" width="348" height="14" fill="url(#iron)" />
        <rect x="6" y="360" width="348" height="10" fill="url(#iron)" />
        {bars.map((x) => (
          <g>
            <rect x={x - 2.5} y="70" width="5" height="822" fill="url(#iron)" />
            <path d={finial(x)} fill="url(#gold)" />
            <circle cx={x} cy="86" r="4.5" fill="url(#gold)" />
          </g>
        ))}
        <g fill="none" stroke="url(#gold)" stroke-width="4" opacity="0.92">
          <path d="M180 452 L236 520 L180 588 L124 520 Z" />
          <circle cx="180" cy="520" r="15" />
          <path d="M180 126 v40 M180 646 v40" stroke-width="3" />
        </g>
      </svg>
    </div>

    <!-- Brand emblem sitting across the seam -->
    <div class="gate-emblem">
      <div class="gate-emblem__ring">
        <img src="/images/ultradoors-logo.webp" alt="" width="120" height="96" />
      </div>
      <span class="gate-emblem__name">Ultra Doors Security</span>
      <span class="gate-emblem__tag">Bespoke · Secure · Built to Last</span>
    </div>
  </div>
</div>

<style>
  .gate-intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% 20%, rgba(24, 99, 220, 0.18), transparent 60%),
      radial-gradient(120% 120% at 50% 100%, #04060b, #0a1020 60%, #0d1526);
    animation: gate-out 0.6s ease 2s forwards;
  }
  .gate-stage {
    position: absolute;
    inset: 0;
    perspective: 1700px;
    perspective-origin: 50% 45%;
  }
  .gate-leaf {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    backface-visibility: hidden;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.6);
    will-change: transform;
  }
  .gate-leaf--left {
    left: 0;
    transform-origin: left center;
    animation: gate-open-left 1.3s cubic-bezier(0.65, 0, 0.2, 1) 0.9s forwards;
  }
  .gate-leaf--right {
    right: 0;
    transform-origin: right center;
    animation: gate-open-right 1.3s cubic-bezier(0.65, 0, 0.2, 1) 0.9s forwards;
  }

  .gate-emblem {
    position: absolute;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: emblem-out 0.55s ease 0.75s forwards;
    will-change: transform, opacity;
  }
  .gate-emblem__ring {
    display: grid;
    place-items: center;
    width: 168px;
    height: 168px;
    border-radius: 9999px;
    background: radial-gradient(circle at 50% 40%, #142138, #0a0f1c);
    border: 3px solid transparent;
    background-clip: padding-box;
    box-shadow:
      0 0 0 3px #d7a53f,
      0 0 40px rgba(215, 165, 63, 0.35),
      inset 0 0 30px rgba(0, 0, 0, 0.6);
  }
  .gate-emblem__ring img {
    width: 108px;
    height: auto;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.5));
  }
  .gate-emblem__name {
    margin-top: 18px;
    font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .gate-emblem__tag {
    margin-top: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #d7a53f;
  }

  @keyframes gate-open-left {
    to { transform: rotateY(-115deg); }
  }
  @keyframes gate-open-right {
    to { transform: rotateY(115deg); }
  }
  @keyframes emblem-out {
    to { opacity: 0; transform: translate(-50%, -60%) scale(1.18); }
  }
  @keyframes gate-out {
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }

  /* Respect reduced-motion: skip the entrance entirely. */
  @media (prefers-reduced-motion: reduce) {
    .gate-intro { display: none; }
  }
</style>

<script is:inline>
  // Safety net: guarantee the overlay is gone shortly after the animation,
  // even on browsers that stall the animation while backgrounded.
  (function () {
    var el = document.querySelector('.gate-intro');
    if (!el) return;
    setTimeout(function () {
      el.style.visibility = 'hidden';
      el.style.pointerEvents = 'none';
    }, 3200);
  })();
</script>
