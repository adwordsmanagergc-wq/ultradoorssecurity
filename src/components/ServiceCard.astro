---
import type { Service } from '../data/services';
interface Props {
  service: Service;
}
const { service } = Astro.props;
---
<article class="card group flex flex-col overflow-hidden hover:-translate-y-1 hover:shadow-card-hover">
  <div class="relative aspect-[16/10] overflow-hidden bg-panel">
    <img
      src={service.image}
      alt={service.alt}
      width="480"
      height="300"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {
      service.emergency && (
        <span class="absolute left-3 top-3 rounded-full bg-emergency px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-white">
          24/7
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold text-navy">{service.title}</h3>
    <p class="mt-2 flex-1 leading-relaxed text-[#3a4b5f]">{service.description}</p>
    <a
      href={`/portfolio#${service.slug}`}
      class="mt-4 inline-flex items-center gap-1.5 font-bold text-accent transition-all group-hover:gap-2.5"
    >
      Learn more
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</article>
