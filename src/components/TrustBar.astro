---
const badges = [
  { label: '15+ years experience', icon: 'M12 7v5l3 2M12 3a9 9 0 100 18 9 9 0 000-18z' },
  { label: 'NVQ qualified fitters', icon: 'M12 3l2.4 5 5.6.8-4 3.9 1 5.5L12 21l-5-2.8 1-5.5-4-3.9 5.6-.8z' },
  { label: 'Bespoke made to measure', icon: 'M4 20l4-1 10-10-3-3L5 16zM14 6l3 3M3 21h6' },
  { label: '24/7 emergency callout', icon: 'M12 8v4l2 2M12 3a9 9 0 100 18 9 9 0 000-18z' },
  { label: 'Free survey & quotations', icon: 'M9 12l2 2 4-4M12 3l7 3v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z' },
];
---
<section aria-label="Why choose us" class="border-b border-black/5 bg-white">
  <ul class="container-x grid grid-cols-2 gap-x-6 gap-y-5 py-6 sm:grid-cols-3 lg:grid-cols-5">
    {
      badges.map((b) => (
        <li class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-panel text-accent">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={b.icon} />
            </svg>
          </span>
          <span class="text-sm font-semibold leading-tight text-navy">{b.label}</span>
        </li>
      ))
    }
  </ul>
</section>
