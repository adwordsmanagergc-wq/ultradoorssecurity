---
import { gallery } from '../data/gallery';
---
<div class="gal group relative">
  <!-- Prev / Next controls -->
  <button
    type="button"
    class="gal-btn gal-prev"
    aria-label="Previous projects"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button
    type="button"
    class="gal-btn gal-next"
    aria-label="Next projects"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
  </button>

  <!-- edge fades -->
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-panel to-transparent sm:w-14"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-panel to-transparent sm:w-14"></div>

  <div class="gal-track flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-1 pb-4">
    {
      gallery.map((item) =>
        item.type === 'beforeAfter' ? (
          <figure class="gal-card snap-start shrink-0">
            <div class="relative flex h-72 w-[30rem] max-w-[86vw] overflow-hidden rounded-2xl shadow-card ring-1 ring-black/5 sm:h-80 sm:w-[36rem]">
              <div class="relative w-1/2">
                <img src={item.before} alt={item.beforeAlt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                <span class="absolute left-2 top-2 rounded-full bg-ink/80 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-white">Before</span>
              </div>
              <div class="relative w-1/2 border-l-2 border-white">
                <img src={item.after} alt={item.afterAlt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                <span class="absolute right-2 top-2 rounded-full bg-accent px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-white">After</span>
              </div>
            </div>
            <figcaption class="mt-3 px-1">
              <span class="text-xs font-semibold uppercase tracking-wide text-accent">{item.category}</span>
              <p class="text-sm font-semibold text-navy">{item.caption}</p>
            </figcaption>
          </figure>
        ) : (
          <figure class="gal-card snap-start shrink-0">
            <div class="h-72 w-60 overflow-hidden rounded-2xl shadow-card ring-1 ring-black/5 sm:h-80 sm:w-72">
              <img src={item.src} alt={item.alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
            <figcaption class="mt-3 px-1">
              <span class="text-xs font-semibold uppercase tracking-wide text-accent">{item.category}</span>
              <p class="text-sm font-semibold text-navy">{item.caption}</p>
            </figcaption>
          </figure>
        )
      )
    }
  </div>
</div>

<style>
  .gal-track { scrollbar-width: none; }
  .gal-track::-webkit-scrollbar { display: none; }
  .gal-btn {
    position: absolute;
    top: 44%;
    z-index: 20;
    display: none;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #fff;
    color: var(--navy);
    box-shadow: 0 10px 24px rgba(2, 13, 26, 0.16);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .gal-btn:hover { background: var(--cream, #f7f4ee); transform: scale(1.05); }
  .gal-prev { left: 0.25rem; }
  .gal-next { right: 0.25rem; }
  @media (min-width: 768px) {
    .gal-btn { display: inline-flex; }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.gal').forEach(function (root) {
      var track = root.querySelector('.gal-track');
      var prev = root.querySelector('.gal-prev');
      var next = root.querySelector('.gal-next');
      if (!track) return;
      function step() {
        var card = track.querySelector('.gal-card');
        var w = card ? card.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
        return Math.max(w, track.clientWidth * 0.6);
      }
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    });
  })();
</script>
