---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---
<Base title="Page Not Found | Ultra Doors Security" description="Sorry, we couldn't find that page." path="/404">
  <Header />
  <main id="main" class="bg-cream">
    <section class="container-x flex min-h-[55vh] flex-col items-center justify-center py-20 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent">404</p>
      <h1 class="mt-2 text-3xl font-extrabold sm:text-4xl">Page not found</h1>
      <p class="mt-3 max-w-md text-lg text-[#3a4b5f]">
        Sorry, that page doesn't exist. Try the home page, or call us and we'll
        point you in the right direction.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/portfolio" class="btn-outline">View portfolio</a>
        <a href={site.emergencyPhone.href} class="btn-outline">Call {site.emergencyPhone.display}</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
