---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---
<Base
  title="Thank You | Ultra Doors Security"
  description="Thank you for contacting Ultra Doors Security. We'll be in touch shortly."
  path="/thank-you"
>
  <Header />
  <main id="main" class="bg-cream">
    <section class="container-x flex min-h-[55vh] flex-col items-center justify-center py-20 text-center">
      <span class="grid h-16 w-16 place-items-center rounded-full bg-accent/10 text-accent">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>
      </span>
      <h1 class="mt-6 text-3xl font-extrabold sm:text-4xl">Thank you</h1>
      <p class="mt-3 max-w-md text-lg text-[#3a4b5f]">
        Your enquiry has been sent, we'll be in touch shortly. For anything
        urgent, please call our 24/7 line.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-outline">Back to home</a>
        <a href={site.emergencyPhone.href} class="btn-emergency">Call {site.emergencyPhone.display}</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
