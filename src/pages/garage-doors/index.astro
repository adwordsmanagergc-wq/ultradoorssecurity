---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { garageTowns, garageDoorTypes, garageDoorBenefits } from '../../data/garageDoors';

const h1 = 'Garage Doors';
const path = '/garage-doors/';
const title = 'Garage Doors | Roller, Sectional & Automated | Ultra Doors Security';
const description =
  'Garage doors supplied, fitted, automated and repaired across Bolton and the North West. Roller, sectional, up-and-over and side-hinged doors, made to measure with a free survey.';

const canonical = new URL(path, site.url).href;
const image = new URL('/images/gallery/roller-shutter-white-garage.jpg', site.url).href;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Garage Doors',
  name: 'Garage Doors',
  description,
  url: canonical,
  image,
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'Place', name: site.location.areaServed },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Garage Doors', item: canonical },
  ],
};
---
<Base
  title={title}
  description={description}
  path={path}
  ogImage="/images/gallery/roller-shutter-white-garage.jpg"
  jsonLd={[serviceSchema, breadcrumb]}
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="bg-navy text-white">
      <div class="container-x py-12 sm:py-16">
        <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/60">
          <a href="/" class="hover:text-white">Home</a>
          <span aria-hidden="true" class="px-1">/</span>
          <span class="text-white">Garage Doors</span>
        </nav>
        <p class="eyebrow text-accent">Made to measure · Fitted &amp; repaired</p>
        <h1 class="mt-3 text-4xl font-extrabold text-white sm:text-5xl">Garage Doors across the North West</h1>
        <p class="mt-4 max-w-2xl text-lg text-white/80">
          Roller, sectional, up-and-over and side-hinged garage doors, supplied
          and fitted by our own team. New doors, automation and repairs, all
          made to measure with a free survey and a clear written price.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">Get a free quote</a>
          <a href={site.emergencyPhone.href} class="btn-emergency">Call us: {site.emergencyPhone.display}</a>
        </div>
      </div>
    </section>

    <!-- Door types + benefits -->
    <section class="bg-white py-14 sm:py-16">
      <div class="container-x grid gap-12 lg:grid-cols-[1fr_20rem]">
        <div class="prose-clean max-w-none">
          <h2 class="text-2xl font-extrabold text-navy">Types of garage door we fit</h2>
          <dl class="mt-4 space-y-4">
            {garageDoorTypes.map((t) => (
              <div>
                <dt class="font-bold text-navy">{t.name}</dt>
                <dd class="mt-1">{t.text}</dd>
              </div>
            ))}
          </dl>

          <h2 class="mt-8 text-2xl font-extrabold text-navy">Why choose Ultra Doors Security</h2>
          <ul class="my-4 grid gap-2 sm:grid-cols-2">
            {garageDoorBenefits.map((b) => (
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 flex-shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <p>
            We repair as well as replace, so if your door has a broken spring,
            frayed cable or a failed motor we can often put it right without a
            full replacement. If it is beyond economical repair, we will tell
            you straight and price a new door with no obligation.
          </p>
        </div>

        <aside class="space-y-6">
          <div class="rounded-2xl bg-cream p-6 shadow-card ring-1 ring-black/5">
            <h2 class="text-lg font-bold text-navy">Free garage door survey</h2>
            <p class="mt-1 text-sm text-[#3a4b5f]">Local, NVQ-qualified fitters. Clear written pricing, no obligation.</p>
            <a href={site.enquiriesPhone.href} class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-navy px-4 py-3 font-bold text-white hover:bg-ink">
              {site.enquiriesPhone.display}
            </a>
            <p class="mt-2 text-center text-xs text-[#5b6b7f]">Enquiries &amp; 24/7 emergency</p>
            <a href="/contact" class="mt-3 block rounded-xl bg-accent px-4 py-3 text-center font-bold text-white hover:bg-accent-hover">Get a free quote</a>
          </div>
        </aside>
      </div>
    </section>

    <!-- Town pages -->
    <section class="bg-cream py-14 sm:py-16">
      <div class="container-x">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow">Local garage door fitting</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Garage doors in your area</h2>
          <p class="mt-4 text-lg text-[#3a4b5f]">
            Choose your town for local garage door fitting, automation and repairs.
          </p>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {garageTowns.map((t) => (
            <a href={`/garage-doors/${t.slug}`} class="card group flex flex-col overflow-hidden hover:-translate-y-1 hover:shadow-card-hover">
              <div class="aspect-[16/10] overflow-hidden bg-panel">
                <img src={t.garage.image} alt={t.garage.imageAlt} width="480" height="300" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-bold text-navy">Garage Doors in {t.name}</h3>
                <p class="mt-1 text-sm text-[#5b6b7f]">{t.county}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 font-bold text-accent transition-all group-hover:gap-2.5">
                  View {t.name}
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
