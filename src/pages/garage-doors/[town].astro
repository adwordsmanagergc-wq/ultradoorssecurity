---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import {
  garageTowns,
  getGarageTown,
  garageDoorTypes,
  garageDoorBenefits,
  garageDoorBody,
} from '../../data/garageDoors';

export function getStaticPaths() {
  return garageTowns.map((t) => ({ params: { town: t.slug } }));
}

const { town: townSlug } = Astro.params as { town: string };
const town = getGarageTown(townSlug);
if (!town) throw new Error(`Unknown garage-doors town: ${townSlug}`);
const g = town.garage;

const h1 = `Garage Doors in ${town.name}`;
const path = `/garage-doors/${town.slug}`;
const title = `Garage Doors ${town.name} | Fitted, Automated & Repaired | Ultra Doors Security`;
// Unique description built from the town's own opening line.
const firstSentence = g.intro.split('. ')[0];
const description = `${firstSentence}. Roller, sectional and up-and-over garage doors supplied, fitted and repaired. Free survey and clear pricing.`.slice(0, 300);

const canonical = new URL(path, site.url).href;
const image = new URL(g.image, site.url).href;

const body = garageDoorBody.map((p) => p.replaceAll('{town}', town.name));
const areaList =
  town.areas.slice(0, -1).join(', ') + ' and ' + town.areas[town.areas.length - 1];

// Nearby garage-door towns for cross-linking.
const nearby = garageTowns.filter((t) => t.slug !== town.slug).slice(0, 6);
// Related local service posts for this town (all exist in the blog).
const related = [
  { name: `Roller Shutters in ${town.name}`, path: `/blog/roller-shutters-${town.slug}` },
  { name: `Security Doors in ${town.name}`, path: `/blog/security-doors-${town.slug}` },
  { name: `Industrial Doors in ${town.name}`, path: `/blog/industrial-doors-${town.slug}` },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Garage Doors',
  name: h1,
  description,
  url: canonical,
  image,
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'City', name: town.name },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'GBP',
    url: canonical,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: g.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Garage Doors', item: site.url + '/garage-doors/' },
    { '@type': 'ListItem', position: 3, name: h1, item: canonical },
  ],
};
---
<Base
  title={title}
  description={description}
  path={path}
  ogImage={g.image}
  jsonLd={[serviceSchema, faqSchema, breadcrumb]}
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="bg-navy text-white">
      <div class="container-x py-12 sm:py-16">
        <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/60">
          <a href="/" class="hover:text-white">Home</a>
          <span aria-hidden="true" class="px-1">/</span>
          <a href="/garage-doors/" class="hover:text-white">Garage Doors</a>
          <span aria-hidden="true" class="px-1">/</span>
          <span class="text-white">{town.name}</span>
        </nav>
        <p class="eyebrow text-accent">Garage Doors · {town.county}</p>
        <h1 class="mt-3 text-4xl font-extrabold text-white sm:text-5xl">{h1}</h1>
        <p class="mt-4 max-w-2xl text-lg text-white/80">{g.intro}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">Get a free quote in {town.name}</a>
          <a href={site.emergencyPhone.href} class="btn-emergency">
            Call us: {site.emergencyPhone.display}
          </a>
        </div>
      </div>
    </section>

    <article class="bg-white py-14">
      <div class="container-x grid gap-12 lg:grid-cols-[1fr_20rem]">
        <div class="prose-clean max-w-none">
          <img
            src={g.image}
            alt={g.imageAlt}
            width="960"
            height="600"
            loading="eager"
            decoding="async"
            class="mb-8 aspect-[16/10] w-full rounded-2xl object-cover shadow-card ring-1 ring-black/5"
          />

          <h2 class="text-2xl font-extrabold text-navy">Garage doors for {town.name} homes</h2>
          {body.map((p) => <p>{p}</p>)}

          <h2 class="mt-8 text-2xl font-extrabold text-navy">Local knowledge across {town.name}</h2>
          <p>{town.intro}</p>
          <p>{g.angle}</p>

          <h2 class="mt-8 text-2xl font-extrabold text-navy">Types of garage door we fit</h2>
          <dl class="mt-4 space-y-4">
            {garageDoorTypes.map((t) => (
              <div>
                <dt class="font-bold text-navy">{t.name}</dt>
                <dd class="mt-1">{t.text}</dd>
              </div>
            ))}
          </dl>

          <h2 class="mt-8 text-2xl font-extrabold text-navy">What you get with Ultra Doors Security</h2>
          <ul class="my-4 grid gap-2 sm:grid-cols-2">
            {garageDoorBenefits.map((b) => (
              <li class="flex items-start gap-2">
                <svg class="mt-1 h-4 w-4 flex-shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <h2 class="mt-8 text-2xl font-extrabold text-navy">Areas we cover around {town.name}</h2>
          <p>
            We regularly fit and repair garage doors across {town.name} and nearby areas including {areaList}. {town.coverage}
          </p>

          <h2 class="mt-8 text-2xl font-extrabold text-navy">FAQs: Garage Doors in {town.name}</h2>
          <dl class="mt-4 divide-y divide-black/10">
            {g.faqs.map((f) => (
              <div class="py-4">
                <dt class="font-bold text-navy">{f.q}</dt>
                <dd class="mt-1.5">{f.a}</dd>
              </div>
            ))}
          </dl>

          <h2 class="mt-10 text-2xl font-extrabold text-navy">Related services in {town.name}</h2>
          <ul class="my-4 grid gap-2 sm:grid-cols-2">
            {related.map((l) => (
              <li class="list-none"><a href={l.path} class="font-semibold text-accent hover:underline">{l.name}</a></li>
            ))}
          </ul>
        </div>

        <!-- Sidebar -->
        <aside class="space-y-6">
          <div class="rounded-2xl bg-cream p-6 shadow-card ring-1 ring-black/5">
            <h2 class="text-lg font-bold text-navy">Free quote in {town.name}</h2>
            <p class="mt-1 text-sm text-[#3a4b5f]">Local, NVQ-qualified fitters. Free survey and a clear written price.</p>
            <a href={site.enquiriesPhone.href} class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-navy px-4 py-3 font-bold text-white hover:bg-ink">
              {site.enquiriesPhone.display}
            </a>
            <p class="mt-2 text-center text-xs text-[#5b6b7f]">Enquiries &amp; 24/7 emergency</p>
            <a href="/contact" class="mt-3 block rounded-xl bg-accent px-4 py-3 text-center font-bold text-white hover:bg-accent-hover">Get a free quote</a>
          </div>

          <div class="rounded-2xl border border-black/10 bg-white p-6">
            <h2 class="text-sm font-bold uppercase tracking-wide text-navy">Garage doors nearby</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {nearby.map((t) => (
                <li><a href={`/garage-doors/${t.slug}`} class="text-accent hover:underline">Garage Doors in {t.name}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
</Base>
