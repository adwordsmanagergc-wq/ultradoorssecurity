---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: site.url + '/contact' },
  ],
};

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent('Bolton, Greater Manchester')}&output=embed`;
---
<Base
  title="Contact Us | Ultra Doors Security"
  description="Contact Ultra Doors Security in Bolton for a free quote or 24/7 emergency callout across the North West. Call, email or send an enquiry."
  path="/contact"
  jsonLd={[breadcrumb]}
>
  <Header />
  <main id="main">
    <section class="bg-navy text-white">
      <div class="container-x py-14 sm:py-16">
        <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/60">
          <a href="/" class="hover:text-white">Home</a>
          <span aria-hidden="true" class="px-1">/</span>
          <span class="text-white">Contact</span>
        </nav>
        <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Get in touch</h1>
        <p class="mt-4 max-w-2xl text-lg text-white/80">
          Free surveys and quotations, and 24/7 emergency support across the
          North West. Call us, email us, or send an enquiry below.
        </p>
      </div>
    </section>

    <section class="bg-cream py-16 sm:py-20">
      <div class="container-x grid gap-10 lg:grid-cols-[1fr_22rem]">
        <!-- Form -->
        <div>
          <h2 class="text-2xl font-extrabold">Send us an enquiry</h2>
          <p class="mt-2 text-[#3a4b5f]">We'll get back to you as soon as we can.</p>
          <div class="mt-6 rounded-3xl bg-white p-6 shadow-card ring-1 ring-black/5 sm:p-8">
            <QuoteForm id="contact" />
          </div>
        </div>

        <!-- Details -->
        <aside class="space-y-6">
          <div class="rounded-3xl bg-white p-6 shadow-card ring-1 ring-black/5">
            <h2 class="text-lg font-bold">Contact details</h2>
            <dl class="mt-4 space-y-4 text-sm">
              <div>
                <dt class="font-semibold text-[#5b6b7f]">Call us (enquiries &amp; 24/7 emergency)</dt>
                <dd><a href={site.emergencyPhone.href} class="text-xl font-extrabold text-emergency hover:underline">{site.emergencyPhone.display}</a></dd>
              </div>
              <div>
                <dt class="font-semibold text-[#5b6b7f]">Email</dt>
                <dd><a href={`mailto:${site.email}`} class="font-semibold text-accent hover:underline">{site.email}</a></dd>
              </div>
              <div>
                <dt class="font-semibold text-[#5b6b7f]">Based in</dt>
                <dd class="text-navy">{site.location.town}, {site.location.region}</dd>
              </div>
              <div>
                <dt class="font-semibold text-[#5b6b7f]">Area served</dt>
                <dd class="text-navy">{site.location.areaServed}</dd>
              </div>
              <div>
                <dt class="font-semibold text-[#5b6b7f]">Hours</dt>
                <dd class="text-navy">{site.hoursText}</dd>
              </div>
            </dl>
          </div>

          <div class="overflow-hidden rounded-3xl shadow-card ring-1 ring-black/5">
            <iframe
              title="Map showing Ultra Doors Security service area around Bolton"
              src={mapSrc}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="h-64 w-full border-0"
              allowfullscreen
            ></iframe>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Base>
