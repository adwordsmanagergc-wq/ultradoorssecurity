---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---
<Base
  title="Privacy Policy | Ultra Doors Security"
  description="How Ultra Doors Security collects, uses and protects the personal information you share with us."
  path="/privacy"
>
  <Header />
  <main id="main" class="bg-white">
    <section class="container-x max-w-3xl py-16">
      <h1 class="text-3xl font-extrabold sm:text-4xl">Privacy Policy</h1>
      <div class="prose-clean mt-6">
        <p>
          This policy explains how {site.name} handles the personal information
          you provide when you contact us or request a quote. We are the data
          controller for that information.
        </p>
        <h2 class="mt-8 text-xl font-bold">What we collect</h2>
        <p>
          When you complete an enquiry or quote form we collect the details you
          give us — typically your name, phone number, email address, postcode
          and a description of the work you need. We only ask for what we need to
          respond to your enquiry and provide a quotation.
        </p>
        <h2 class="mt-8 text-xl font-bold">How we use it</h2>
        <p>
          We use your details to respond to your enquiry, arrange a survey,
          prepare a quotation and carry out any work you go on to book. We do not
          sell your information, and we do not use it for marketing unless you
          have asked us to.
        </p>
        <h2 class="mt-8 text-xl font-bold">Keeping it safe &amp; how long we keep it</h2>
        <p>
          Your information is stored securely and kept only for as long as needed
          to deal with your enquiry and any resulting work, plus any period we are
          required to keep records for legal or accounting reasons.
        </p>
        <h2 class="mt-8 text-xl font-bold">Your rights</h2>
        <p>
          Under UK GDPR you can ask us for a copy of the information we hold about
          you, ask us to correct it, or ask us to delete it. To make a request,
          email <a href={`mailto:${site.email}`} class="font-semibold text-accent hover:underline">{site.email}</a>
          or call {site.enquiriesPhone.display}.
        </p>
        <p class="mt-6 text-sm text-[#5b6b7f]">
          This is a general policy — please review it with your own advisor before
          publishing to ensure it reflects your exact data practices.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
