---
import Base from '../layouts/Base.astro';
import GateIntro from '../components/GateIntro.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import WhyUs from '../components/WhyUs.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { projects } from '../data/portfolio';
import { testimonials, aggregateRating } from '../data/testimonials';

// Recent-projects subset for the home gallery (portfolio page shows all).
const recent = [
  ...projects.filter((p) => p.category === 'Security Doors').slice(0, 2),
  ...projects.filter((p) => p.category === 'Roller Shutters').slice(0, 2),
  ...projects.filter((p) => p.category === 'Industrial Doors').slice(0, 2),
  ...projects.filter((p) => p.category === 'Shop Fronts & Glazing').slice(0, 2),
  ...projects.filter((p) => p.category === 'Security Gates').slice(0, 4),
];

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue,
    reviewCount: aggregateRating.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
  review: testimonials.map((t) => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: t.rating, bestRating: 5, worstRating: 1 },
    author: { '@type': 'Person', name: t.name },
    reviewBody: t.quote,
  })),
};
---
<Base
  title="Security & Industrial Doors Bolton | Ultra Doors Security"
  description="Bespoke security doors, roller shutters, industrial doors & shop fronts across the North West. 15+ years, NVQ-qualified fitters, 24/7 emergency callout."
  path="/"
  jsonLd={[reviewSchema]}
>
  <GateIntro />
  <Header />
  <div id="main">
    <Hero />
    <TrustBar />
    <ServicesGrid />
    <WhyUs />

    <!-- Recent projects -->
    <section class="bg-panel py-20 sm:py-24">
      <div class="container-x">
        <div class="mx-auto max-w-2xl text-center reveal">
          <p class="eyebrow">Our work</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Recent projects</h2>
          <p class="mt-4 text-lg text-[#3a4b5f]">
            A selection of completed installations. Filter by category, or
            <a href="/portfolio" class="font-semibold text-accent hover:underline">view the full portfolio</a>.
          </p>
        </div>
        <div class="mt-10">
          <Gallery projects={recent} id="home-gallery" />
        </div>
      </div>
    </section>

    <Testimonials />

    <!-- Quote + emergency -->
    <section id="quote" class="bg-white py-20 sm:py-24">
      <div class="container-x grid items-start gap-10 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="reveal">
          <p class="eyebrow">Free, no-obligation</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Get your free quote today</h2>
          <p class="mt-4 text-lg text-[#3a4b5f]">
            Tell us about your project and we'll arrange a free survey and a
            clear quotation. Bespoke, built to last and installed by an
            experienced team.
          </p>
          <div class="mt-8 rounded-3xl bg-cream p-6 shadow-card ring-1 ring-black/5 sm:p-8">
            <QuoteForm id="home" />
          </div>
        </div>

        <!-- Emergency panel -->
        <aside class="reveal rounded-3xl bg-gradient-to-br from-navy to-ink p-8 text-white shadow-card">
          <span class="inline-flex items-center gap-2 rounded-full bg-emergency/20 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
            <span class="h-2 w-2 rounded-full bg-emergency"></span> 24/7 Emergency
          </span>
          <h3 class="mt-4 text-2xl font-bold text-white">Need us urgently?</h3>
          <p class="mt-2 text-white/75">
            Break-in, storm damage or a failed shutter? Our emergency team covers
            the North West around the clock, including boarding up and same-day
            glass replacement.
          </p>
          <div class="mt-6 space-y-3">
            <a href={site.emergencyPhone.href} class="btn-emergency w-full text-lg">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h4l2 5-2.5 1.5a11 11 0 005 5L14 13l5 2v4a2 2 0 01-2 2A15 15 0 013 6a2 2 0 011-2z"/></svg>
              {site.emergencyPhone.display}
            </a>
            <a href={site.enquiriesPhone.href} class="btn-ghost w-full text-base">
              General enquiries: {site.enquiriesPhone.display}
            </a>
          </div>
          <dl class="mt-8 space-y-3 border-t border-white/15 pt-6 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-white/60">Email</dt><dd><a href={`mailto:${site.email}`} class="text-white hover:text-accent">{site.email}</a></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-white/60">Hours</dt><dd class="text-right text-white">{site.hoursText}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-white/60">Area</dt><dd class="text-white">{site.location.areaServed}</dd></div>
          </dl>
        </aside>
      </div>
    </section>
  </div>
  <Footer />
</Base>
