---
import '../../styles/global.css';
import { site } from '../../data/site';

// Owner-only tool: keep it out of search indexes.
export const prerender = true;
const inv = site.invoice;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Invoicing · Ultra Doors Security</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="min-h-screen bg-panel text-navy">
    <!-- Passcode gate -->
    <div id="gate" class="fixed inset-0 z-50 grid place-items-center bg-ink px-4">
      <form id="gate-form" class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-card">
        <div class="flex justify-center">
          <img src="/images/invoice-logo.png" alt="Ultra Doors Security" class="h-14 w-auto" />
        </div>
        <h1 class="mt-5 text-center text-xl font-extrabold">Invoicing login</h1>
        <p class="mt-1 text-center text-sm text-[#5b6b7f]">Enter your passcode to continue.</p>
        <input
          id="gate-code"
          type="password"
          inputmode="text"
          autocomplete="off"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          class="mt-5 w-full rounded-xl border border-muted px-4 py-3 text-center text-lg tracking-widest focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          placeholder="Passcode"
          aria-label="Passcode"
        />
        <p id="gate-error" class="mt-2 hidden text-center text-sm font-medium text-emergency">Incorrect passcode, please try again.</p>
        <button type="submit" class="btn-primary mt-4 w-full">Unlock</button>
        <a href="/" class="mt-3 block text-center text-sm text-[#5b6b7f] hover:text-accent">Back to website</a>
      </form>
    </div>

    <!-- App -->
    <div id="app" class="hidden">
      <header class="border-b border-black/10 bg-white">
        <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3">
          <div class="flex items-center gap-3">
            <img src="/images/invoice-logo.png" alt="Ultra Doors Security" class="h-9 w-auto" />
            <span class="text-lg font-extrabold">Invoicing</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex rounded-xl bg-panel p-1">
              <button data-screen="builder" class="screenbtn rounded-lg px-3 py-1.5 text-sm font-bold">Invoice</button>
              <button data-screen="records" class="screenbtn rounded-lg px-3 py-1.5 text-sm font-bold">Records</button>
            </div>
            <a href="/" class="hidden rounded-lg px-3 py-2 text-sm font-semibold text-navy hover:bg-panel sm:block">Website</a>
            <button id="logout" type="button" class="rounded-lg border border-muted px-2.5 py-2 text-sm font-semibold hover:border-accent hover:text-accent">Log out</button>
          </div>
        </div>
      </header>

      <!-- BUILDER SCREEN -->
      <div id="builder-screen">

      <!-- Mobile Edit / Preview tabs -->
      <div class="no-print sticky top-0 z-30 border-b border-black/10 bg-panel/95 backdrop-blur lg:hidden">
        <div class="mx-auto grid max-w-content grid-cols-2 gap-2 px-4 py-2">
          <button data-tab="edit" class="tabbtn rounded-xl px-4 py-2.5 text-sm font-bold">Edit invoice</button>
          <button data-tab="preview" class="tabbtn rounded-xl px-4 py-2.5 text-sm font-bold">Preview</button>
        </div>
      </div>

      <main class="mx-auto grid max-w-content gap-8 px-4 pb-28 pt-6 lg:grid-cols-[380px_1fr] lg:pb-10 lg:pt-8">
        <!-- EDIT PANE -->
        <section id="edit-pane" class="no-print space-y-5 lg:block">
          <div class="rounded-2xl bg-white p-6 shadow-card">
            <h2 class="text-lg font-bold">Invoice details</h2>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <label class="block text-sm">
                <span class="font-semibold text-[#5b6b7f]">Invoice no.</span>
                <input id="f-number" type="text" class="mt-1 w-full rounded-lg border border-muted px-3 py-2 focus:border-accent focus:outline-none" />
              </label>
              <label class="block text-sm">
                <span class="font-semibold text-[#5b6b7f]">Date</span>
                <input id="f-date" type="date" class="mt-1 w-full rounded-lg border border-muted px-3 py-2 focus:border-accent focus:outline-none" />
              </label>
            </div>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-card">
            <h2 class="text-lg font-bold">Client</h2>
            <label class="mt-4 block text-sm">
              <span class="font-semibold text-[#5b6b7f]">Client name</span>
              <input id="f-client" type="text" placeholder="e.g. Mill Stores Cleveleys C/O Ena Mill" class="mt-1 w-full rounded-lg border border-muted px-3 py-2 focus:border-accent focus:outline-none" />
            </label>
            <label class="mt-3 block text-sm">
              <span class="font-semibold text-[#5b6b7f]">Address</span>
              <textarea id="f-address" rows="3" placeholder="Flapper Fold Lane&#10;Atherton&#10;M46 0HB" class="mt-1 w-full rounded-lg border border-muted px-3 py-2 focus:border-accent focus:outline-none"></textarea>
            </label>
            <label class="mt-3 block text-sm">
              <span class="font-semibold text-[#5b6b7f]">Client email <span class="font-normal">(for sending)</span></span>
              <input id="f-email" type="email" placeholder="client@example.com" class="mt-1 w-full rounded-lg border border-muted px-3 py-2 focus:border-accent focus:outline-none" />
            </label>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-card">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-bold">Products / services</h2>
              <button id="add-row" type="button" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-bold text-white hover:bg-accent-hover">+ Add row</button>
            </div>
            <p class="mt-1 text-xs text-[#5b6b7f]">Amount = Unit × Price. The invoice Total adds up every Amount.</p>
            <div id="rows" class="mt-4 space-y-3"></div>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-card">
            <h2 class="text-lg font-bold">Notes <span class="text-sm font-normal text-[#5b6b7f]">(optional)</span></h2>
            <textarea id="f-notes" rows="2" placeholder="Anything else to add to the invoice." class="mt-3 w-full rounded-lg border border-muted px-3 py-2 focus:border-accent focus:outline-none"></textarea>
          </div>

          <!-- Desktop action bar -->
          <div class="hidden rounded-2xl bg-navy p-4 shadow-card lg:block">
            <div class="grid grid-cols-2 gap-2">
              <button data-act="pdf" type="button" class="rounded-xl bg-white px-4 py-3 font-bold text-navy hover:bg-panel">Download PDF</button>
              <button data-act="print" type="button" class="rounded-xl border border-white/30 px-4 py-3 font-bold text-white hover:bg-white/10">Print</button>
              <button data-act="send" type="button" class="col-span-2 rounded-xl bg-accent px-4 py-3 font-bold text-white hover:bg-accent-hover">Send to client</button>
              <button data-act="new" type="button" class="col-span-2 rounded-xl border border-white/20 px-4 py-2.5 text-sm font-semibold text-white/80 hover:bg-white/10">Start new invoice</button>
            </div>
            <p class="send-note mt-3 hidden text-center text-sm text-white"></p>
          </div>
        </section>

        <!-- PREVIEW PANE -->
        <section id="preview-pane" class="hidden lg:block">
          <div class="mb-3 flex items-center gap-2 text-sm font-semibold text-[#5b6b7f] no-print">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            Live preview
          </div>
          <div class="preview-scaler mx-auto overflow-hidden rounded-lg">
            <div id="invoice-preview" class="bg-white shadow-card" style="width:820px;transform-origin:top left;"></div>
          </div>
        </section>
      </main>

      <!-- Mobile action bar -->
      <div class="no-print fixed inset-x-0 bottom-0 z-30 border-t border-white/10 bg-navy px-3 py-2.5 lg:hidden">
        <div class="mx-auto max-w-content">
          <p class="send-note mb-2 hidden text-center text-xs text-white"></p>
          <div class="grid grid-cols-2 gap-2">
            <button data-act="pdf" type="button" class="rounded-xl bg-white px-3 py-2.5 text-sm font-bold text-navy">Download PDF</button>
            <button data-act="send" type="button" class="rounded-xl bg-accent px-3 py-2.5 text-sm font-bold text-white">Send to client</button>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <button data-act="print" type="button" class="rounded-xl border border-white/25 px-3 py-2 text-xs font-semibold text-white">Print</button>
            <button data-act="new" type="button" class="rounded-xl border border-white/15 px-3 py-2 text-xs font-semibold text-white/80">New invoice</button>
          </div>
        </div>
      </div>
      </div><!-- /builder-screen -->

      <!-- RECORDS SCREEN -->
      <div id="records-screen" class="hidden">
        <main class="mx-auto max-w-content px-4 pb-16 pt-6 lg:pt-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-xl font-extrabold">Invoices &amp; payments</h2>
              <p id="rec-status" class="mt-0.5 text-sm text-[#5b6b7f]"></p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button id="rec-sync" type="button" class="rounded-lg border border-muted px-3 py-2 text-sm font-semibold hover:border-accent hover:text-accent">Sync device → cloud</button>
              <button id="rec-export" type="button" class="rounded-lg border border-muted px-3 py-2 text-sm font-semibold hover:border-accent hover:text-accent">Back up</button>
              <button id="rec-import" type="button" class="rounded-lg border border-muted px-3 py-2 text-sm font-semibold hover:border-accent hover:text-accent">Restore</button>
              <input id="rec-file" type="file" accept="application/json" class="hidden" />
            </div>
          </div>

          <!-- Summary cards -->
          <div id="rec-summary" class="mt-5 grid gap-3 sm:grid-cols-3"></div>

          <!-- Breakdown by year / month -->
          <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <div class="rounded-2xl bg-white p-5 shadow-card">
              <h3 class="font-bold">By year</h3>
              <div id="rec-years" class="mt-3 overflow-x-auto"></div>
            </div>
            <div class="rounded-2xl bg-white p-5 shadow-card">
              <h3 class="font-bold">By month</h3>
              <div id="rec-months" class="mt-3 overflow-x-auto"></div>
            </div>
          </div>

          <!-- Invoice list -->
          <div class="mt-6 rounded-2xl bg-white p-5 shadow-card">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="font-bold">All invoices</h3>
              <div class="flex flex-wrap gap-2">
                <input id="rec-search" type="search" placeholder="Search client or number" class="rounded-lg border border-muted px-3 py-2 text-sm focus:border-accent focus:outline-none" />
                <select id="rec-filter-status" class="rounded-lg border border-muted px-3 py-2 text-sm focus:border-accent focus:outline-none">
                  <option value="all">All statuses</option>
                  <option value="sent">Unpaid</option>
                  <option value="paid">Paid</option>
                </select>
              </div>
            </div>
            <div id="rec-list" class="mt-3 overflow-x-auto"></div>
          </div>
        </main>
      </div>
    </div>

    <style>
      .tabbtn { border: 1px solid var(--muted); background: #fff; color: var(--navy); transition: all 0.15s; }
      .tabbtn[aria-selected='true'] { background: var(--navy); color: #fff; border-color: var(--navy); }
      .screenbtn { color: #5b6b7f; transition: all 0.15s; }
      .screenbtn[aria-selected='true'] { background: #fff; color: var(--navy); box-shadow: 0 1px 2px rgba(2, 13, 26, 0.1); }

      @media print {
        body { background: #fff; }
        #gate, header, #records-screen, .no-print { display: none !important; }
        #app { display: block !important; }
        #edit-pane { display: none !important; }
        #preview-pane { display: block !important; }
        main { display: block !important; padding: 0 !important; }
        .preview-scaler { overflow: visible !important; height: auto !important; border-radius: 0 !important; }
        #invoice-preview { transform: none !important; width: 100% !important; box-shadow: none !important; }
      }
    </style>

    <script>
      import { site } from '../../data/site';
      import { jsPDF } from 'jspdf';
      import autoTable from 'jspdf-autotable';
      import { createClient } from '@supabase/supabase-js';
      import {
        invoiceTotal,
        lineAmount,
        formatGBP,
        formatDateUK,
        makeInvoiceNumber,
        addressLines,
      } from '../../lib/invoice';

      const inv = site.invoice;
      const PASSCODE =
        (import.meta.env.PUBLIC_INVOICE_PASSCODE as string) || inv.passcode;

      // Supabase (cloud-synced records). Falls back to on-device storage when
      // not configured or when signed in with the local passcode.
      const SB_URL = (import.meta.env.PUBLIC_SUPABASE_URL as string) || inv.supabase.url;
      const SB_KEY = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string) || inv.supabase.anonKey;
      const OWNER_EMAIL = (import.meta.env.PUBLIC_INVOICE_OWNER_EMAIL as string) || inv.supabase.ownerEmail;
      const supabase = SB_URL && SB_KEY ? createClient(SB_URL, SB_KEY) : null;
      let cloudMode = false;

      // ---------- Passcode gate ----------
      const gate = document.getElementById('gate')!;
      const app = document.getElementById('app')!;
      function unlock() {
        gate.style.display = 'none';
        app.classList.remove('hidden');
      }
      async function proceed() {
        unlock();
        init();
        await loadRecords();
      }
      async function attemptLogin(code: string): Promise<boolean> {
        // Try cloud auth first (passcode = the owner account's password).
        if (supabase && OWNER_EMAIL) {
          try {
            const { error } = await supabase.auth.signInWithPassword({ email: OWNER_EMAIL, password: code });
            if (!error) { cloudMode = true; sessionStorage.setItem('uds_admin_ok', '1'); await proceed(); return true; }
          } catch {}
        }
        // Fall back to the local passcode (offline, or before the cloud user exists).
        if (code === PASSCODE) { cloudMode = false; sessionStorage.setItem('uds_admin_ok', '1'); await proceed(); return true; }
        return false;
      }

      document.getElementById('gate-form')!.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('gate-code') as HTMLInputElement;
        const btn = (e.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
        if (btn) { btn.disabled = true; btn.textContent = 'Checking…'; }
        const ok = await attemptLogin(input.value.trim());
        if (btn) { btn.disabled = false; btn.textContent = 'Unlock'; }
        if (!ok) document.getElementById('gate-error')!.classList.remove('hidden');
      });

      document.getElementById('logout')!.addEventListener('click', async () => {
        sessionStorage.removeItem('uds_admin_ok');
        if (supabase) { try { await supabase.auth.signOut(); } catch {} }
        location.reload();
      });

      // Auto-unlock if a cloud session or a local unlock already exists.
      // The microtask tick defers this past the rest of the module so all the
      // later const/function declarations (els, init, loadRecords…) are ready.
      (async () => {
        await Promise.resolve();
        if (supabase) {
          try {
            const { data } = await supabase.auth.getSession();
            if (data.session) { cloudMode = true; await proceed(); return; }
          } catch {}
        }
        if (sessionStorage.getItem('uds_admin_ok') === '1') await proceed();
      })();

      // ---------- State ----------
      type Row = { productType: string; description: string; unit: string; price: string };
      const DRAFT = 'uds_invoice_draft';
      const SEQ = 'uds_invoice_seq';
      const RECORDS = 'uds_invoices';

      function todayISO() {
        const d = new Date();
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      }
      function nextSeq() {
        return (parseInt(localStorage.getItem(SEQ) || '0', 10) || 0) + 1;
      }
      function genNumber() {
        return makeInvoiceNumber(inv.numberPrefix, nextSeq(), new Date().getFullYear());
      }

      const els = {
        number: () => document.getElementById('f-number') as HTMLInputElement,
        date: () => document.getElementById('f-date') as HTMLInputElement,
        client: () => document.getElementById('f-client') as HTMLInputElement,
        address: () => document.getElementById('f-address') as HTMLTextAreaElement,
        email: () => document.getElementById('f-email') as HTMLInputElement,
        notes: () => document.getElementById('f-notes') as HTMLTextAreaElement,
        rows: () => document.getElementById('rows')!,
        preview: () => document.getElementById('invoice-preview')!,
      };

      function rowHtml(r: Row, i: number) {
        const field = 'w-full rounded-lg border border-muted px-2.5 py-2 text-sm focus:border-accent focus:outline-none';
        return `
          <div class="row rounded-xl border border-muted bg-white p-3" data-i="${i}">
            <input data-k="productType" value="${escapeAttr(r.productType)}" placeholder="Product type (e.g. R/S)" class="${field} font-semibold" />
            <div class="mt-2 grid grid-cols-2 gap-2">
              <label class="block text-xs font-semibold text-[#5b6b7f]">Qty
                <input data-k="unit" value="${escapeAttr(r.unit)}" inputmode="decimal" placeholder="1" class="mt-1 ${field}" />
              </label>
              <label class="block text-xs font-semibold text-[#5b6b7f]">Price each £
                <input data-k="price" value="${escapeAttr(r.price)}" type="number" step="0.01" min="0" placeholder="0.00" class="mt-1 ${field}" />
              </label>
            </div>
            <textarea data-k="description" rows="2" placeholder="Description of the work" class="mt-2 ${field}">${escapeHtml(r.description)}</textarea>
            <div class="mt-1.5 flex justify-end">
              <button type="button" class="del-row text-xs font-semibold text-emergency hover:underline">Remove row</button>
            </div>
          </div>`;
      }

      function readRows(): Row[] {
        return Array.from(els.rows().querySelectorAll('.row')).map((el) => {
          const get = (k: string) =>
            (el.querySelector(`[data-k="${k}"]`) as HTMLInputElement | HTMLTextAreaElement).value;
          return {
            productType: get('productType'),
            description: get('description'),
            unit: get('unit'),
            price: get('price'),
          };
        });
      }

      function currentData() {
        const rows = readRows();
        return {
          number: els.number().value,
          dateISO: els.date().value,
          clientName: els.client().value,
          clientAddress: els.address().value,
          clientEmail: els.email().value,
          notes: els.notes().value,
          items: rows.map((r) => ({
            productType: r.productType,
            description: r.description,
            unit: r.unit,
            price: parseFloat(r.price) || 0,
          })),
          _rows: rows,
        };
      }

      function saveDraft() {
        const d = currentData();
        localStorage.setItem(DRAFT, JSON.stringify(d));
      }

      // ---------- Preview ----------
      function renderPreview() {
        const d = currentData();
        const total = invoiceTotal(d.items);
        const addr = addressLines(d.clientAddress);
        const itemsRows = d.items
          .filter((it) => it.productType || it.description || it.unit || it.price)
          .map(
            (it) => `
            <tr>
              <td style="padding:10px 12px;border-bottom:1px solid #e7edf4;font-weight:600;">${escapeHtml(it.productType)}</td>
              <td style="padding:10px 12px;border-bottom:1px solid #e7edf4;">${escapeHtml(it.description)}</td>
              <td style="padding:10px 12px;border-bottom:1px solid #e7edf4;text-align:center;">${escapeHtml(it.unit)}</td>
              <td style="padding:10px 12px;border-bottom:1px solid #e7edf4;text-align:right;white-space:nowrap;">${it.price ? formatGBP(it.price) : ''}</td>
              <td style="padding:10px 12px;border-bottom:1px solid #e7edf4;text-align:right;white-space:nowrap;font-weight:600;">${it.price ? formatGBP(lineAmount(it)) : ''}</td>
            </tr>`
          )
          .join('');

        els.preview().innerHTML = `
        <div style="padding:44px 46px;font-family:Inter,system-ui,sans-serif;color:#152437;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:24px;">
            <div>
              <img src="/images/invoice-logo.png" alt="" style="height:60px;width:auto;" />
              <div style="margin-top:14px;font-weight:800;font-size:15px;">${escapeHtml(inv.tradingName)}</div>
              <div style="font-size:12px;color:#5b6b7f;line-height:1.5;margin-top:2px;">
                ${inv.addressLines.map(escapeHtml).join('<br>')}<br>
                ${escapeHtml(inv.phone)} · ${escapeHtml(inv.emergencyPhone)}<br>
                ${escapeHtml(inv.email)} · ${escapeHtml(inv.website)}
              </div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:34px;font-weight:800;letter-spacing:-0.02em;color:#1863dc;line-height:1;">INVOICE</div>
              <div style="margin-top:12px;font-size:12px;color:#5b6b7f;">Invoice no.</div>
              <div style="font-weight:700;">${escapeHtml(d.number)}</div>
              <div style="margin-top:6px;font-size:12px;color:#5b6b7f;">Date</div>
              <div style="font-weight:700;">${formatDateUK(d.dateISO)}</div>
            </div>
          </div>

          <div style="height:3px;background:linear-gradient(90deg,#1863dc,#e11d2a);border-radius:2px;margin:22px 0;"></div>

          <div style="font-size:12px;color:#5b6b7f;text-transform:uppercase;letter-spacing:0.08em;font-weight:700;">Bill to</div>
          <div style="margin-top:6px;font-weight:800;font-size:16px;">${escapeHtml(d.clientName) || '<span style="color:#b9c3d1;">Client name</span>'}</div>
          <div style="font-size:13px;color:#33445a;line-height:1.5;">${addr.map(escapeHtml).join('<br>')}</div>

          <table style="width:100%;border-collapse:collapse;margin-top:26px;font-size:13px;">
            <thead>
              <tr style="background:#152437;color:#fff;">
                <th style="padding:11px 12px;text-align:left;border-top-left-radius:8px;">Product Type</th>
                <th style="padding:11px 12px;text-align:left;">Description</th>
                <th style="padding:11px 12px;text-align:center;">Unit</th>
                <th style="padding:11px 12px;text-align:right;">Price</th>
                <th style="padding:11px 12px;text-align:right;border-top-right-radius:8px;">Amount</th>
              </tr>
            </thead>
            <tbody>${itemsRows || '<tr><td colspan="5" style="padding:16px;color:#b9c3d1;">Add your products or services on the left.</td></tr>'}</tbody>
          </table>

          <div style="display:flex;justify-content:flex-end;margin-top:18px;">
            <div style="min-width:220px;">
              <div style="display:flex;justify-content:space-between;align-items:center;background:#eff5fb;border:2px solid #1863dc;border-radius:10px;padding:12px 16px;">
                <span style="font-weight:800;font-size:15px;">Total</span>
                <span style="font-weight:800;font-size:20px;color:#1863dc;">${formatGBP(total)}</span>
              </div>
            </div>
          </div>

          ${d.notes ? `<div style="margin-top:22px;font-size:12.5px;color:#33445a;"><strong>Notes:</strong> ${escapeHtml(d.notes)}</div>` : ''}

          <div style="margin-top:34px;padding-top:18px;border-top:1px solid #e7edf4;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;">
            <div style="font-size:12.5px;color:#33445a;line-height:1.7;">
              <div style="font-weight:800;color:#152437;">Bank details</div>
              ${escapeHtml(inv.bank.name)}<br>
              Sort code ${escapeHtml(inv.bank.sortCode)}<br>
              Account number ${escapeHtml(inv.bank.accountNumber)}
            </div>
            <div style="font-size:12.5px;color:#33445a;line-height:1.7;text-align:right;">
              <div>${escapeHtml(inv.terms)}</div>
              <div style="margin-top:10px;">${escapeHtml(inv.signOff)}</div>
              <div style="font-weight:800;color:#152437;">${escapeHtml(inv.signatory)}</div>
            </div>
          </div>
        </div>`;
        fitPreview();
        // Refit once the logo image loads (its height affects the total height).
        els.preview().querySelectorAll('img').forEach((img) => {
          if (!(img as HTMLImageElement).complete) img.addEventListener('load', fitPreview, { once: true });
        });
      }

      // Scale the fixed-width invoice preview to fit its container (key on mobile).
      function fitPreview() {
        const pv = els.preview();
        const scaler = pv.parentElement as HTMLElement;
        if (!scaler) return;
        const w = scaler.clientWidth;
        if (w === 0) return; // pane not visible yet; the ResizeObserver will refit
        const scale = Math.min(1, w / 820);
        pv.style.transform = `scale(${scale})`;
        scaler.style.height = pv.offsetHeight * scale + 'px';
      }
      window.addEventListener('resize', fitPreview);

      // ---------- PDF ----------
      let logoDataUrl: string | null = null;
      async function loadLogo() {
        if (logoDataUrl) return logoDataUrl;
        const res = await fetch('/images/invoice-logo.png');
        const blob = await res.blob();
        logoDataUrl = await new Promise((resolve) => {
          const r = new FileReader();
          r.onload = () => resolve(r.result as string);
          r.readAsDataURL(blob);
        });
        return logoDataUrl;
      }

      async function buildPdf() {
        const d = currentData();
        const total = invoiceTotal(d.items);
        const doc = new jsPDF({ unit: 'mm', format: 'a4' });
        const W = 210;
        const m = 14;
        const navy = [21, 36, 55] as [number, number, number];
        const blue = [24, 99, 220] as [number, number, number];
        const grey = [91, 107, 127] as [number, number, number];

        // Logo
        try {
          const logo = await loadLogo();
          doc.addImage(logo, 'PNG', m, 12, 30, 30 * (353 / 440));
        } catch {}

        // Header right
        doc.setTextColor(...blue);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(26);
        doc.text('INVOICE', W - m, 22, { align: 'right' });
        doc.setFontSize(9);
        doc.setTextColor(...grey);
        doc.setFont('helvetica', 'normal');
        doc.text('Invoice no.', W - m, 30, { align: 'right' });
        doc.setTextColor(...navy);
        doc.setFont('helvetica', 'bold');
        doc.text(d.number || '', W - m, 34.5, { align: 'right' });
        doc.setTextColor(...grey);
        doc.setFont('helvetica', 'normal');
        doc.text('Date', W - m, 41, { align: 'right' });
        doc.setTextColor(...navy);
        doc.setFont('helvetica', 'bold');
        doc.text(formatDateUK(d.dateISO), W - m, 45.5, { align: 'right' });

        // Business block (left, under logo)
        let by = 44;
        doc.setTextColor(...navy);
        doc.setFontSize(11);
        doc.text(inv.tradingName, m, by);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8.5);
        doc.setTextColor(...grey);
        by += 5;
        [...inv.addressLines, `${inv.phone}  ·  ${inv.emergencyPhone}`, `${inv.email}  ·  ${inv.website}`].forEach((line) => {
          doc.text(line, m, by);
          by += 4.2;
        });

        // Divider (below the business block so it never overlaps the text)
        doc.setDrawColor(...blue);
        doc.setLineWidth(0.8);
        doc.line(m, 66, W - m, 66);

        // Bill to
        doc.setFontSize(8);
        doc.setTextColor(...grey);
        doc.setFont('helvetica', 'bold');
        doc.text('BILL TO', m, 74);
        doc.setFontSize(12);
        doc.setTextColor(...navy);
        doc.text(d.clientName || '', m, 80);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(10);
        doc.setTextColor(51, 68, 90);
        let ay = 85.5;
        addressLines(d.clientAddress).forEach((line) => {
          doc.text(line, m, ay);
          ay += 5;
        });

        // Table
        const body = d.items
          .filter((it) => it.productType || it.description || it.unit || it.price)
          .map((it) => [
            it.productType,
            it.description,
            it.unit,
            it.price ? formatGBP(it.price) : '',
            it.price ? formatGBP(lineAmount(it)) : '',
          ]);
        autoTable(doc, {
          startY: Math.max(ay + 4, 92),
          head: [['Product Type', 'Description', 'Unit', 'Price', 'Amount']],
          body: body.length ? body : [['', '', '', '', '']],
          theme: 'grid',
          headStyles: { fillColor: navy, textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 10 },
          bodyStyles: { fontSize: 10, textColor: [30, 41, 59], cellPadding: 3 },
          columnStyles: {
            0: { cellWidth: 26, fontStyle: 'bold' },
            2: { cellWidth: 15, halign: 'center' },
            3: { cellWidth: 24, halign: 'right' },
            4: { cellWidth: 26, halign: 'right', fontStyle: 'bold' },
          },
          margin: { left: m, right: m },
        });

        const finalY = (doc as any).lastAutoTable.finalY || 120;

        // Total box
        doc.setFillColor(239, 245, 251);
        doc.setDrawColor(...blue);
        doc.setLineWidth(0.6);
        doc.roundedRect(W - m - 70, finalY + 6, 70, 14, 2, 2, 'FD');
        doc.setTextColor(...navy);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.text('Total', W - m - 65, finalY + 15);
        doc.setTextColor(...blue);
        doc.setFontSize(14);
        doc.text(formatGBP(total), W - m - 4, finalY + 15, { align: 'right' });

        let fy = finalY + 34;
        if (d.notes) {
          doc.setTextColor(51, 68, 90);
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(9);
          const notes = doc.splitTextToSize('Notes: ' + d.notes, W - 2 * m);
          doc.text(notes, m, fy);
          fy += notes.length * 4.5 + 6;
        }

        // Bank + sign off near the bottom
        const bottomY = Math.max(fy, 250);
        doc.setDrawColor(231, 237, 244);
        doc.setLineWidth(0.4);
        doc.line(m, bottomY - 6, W - m, bottomY - 6);
        doc.setTextColor(...navy);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.text('Bank details', m, bottomY);
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9.5);
        doc.setTextColor(51, 68, 90);
        doc.text(inv.bank.name, m, bottomY + 5.5);
        doc.text(`Sort code ${inv.bank.sortCode}`, m, bottomY + 10.5);
        doc.text(`Account number ${inv.bank.accountNumber}`, m, bottomY + 15.5);

        doc.text(inv.terms, W - m, bottomY, { align: 'right' });
        doc.text(inv.signOff, W - m, bottomY + 8, { align: 'right' });
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(...navy);
        doc.text(inv.signatory, W - m, bottomY + 13, { align: 'right' });

        return { doc, data: d };
      }

      function fileName(d: { number: string; clientName: string }) {
        const client = (d.clientName || 'client').replace(/[^a-z0-9]+/gi, '-').slice(0, 30);
        return `Invoice-${d.number || 'draft'}-${client}.pdf`;
      }

      async function downloadPdf() {
        const { doc, data } = await buildPdf();
        doc.save(fileName(data));
        await saveRecord(data);
        return data;
      }

      // ---------- Send ----------
      async function sendToClient() {
        const d = currentData();
        if (!d.clientEmail) {
          setNote('Add the client email above first, then press Send.');
          switchTab('edit');
          els.email().focus();
          return;
        }
        const data = await downloadPdf();
        const total = invoiceTotal(d.items);
        const lines = [
          `Dear ${d.clientName || 'customer'},`,
          '',
          `Please find attached invoice ${d.number} dated ${formatDateUK(d.dateISO)}.`,
          '',
          `Total due: ${formatGBP(total)}`,
          '',
          'Payment details:',
          inv.bank.name,
          `Sort code ${inv.bank.sortCode}`,
          `Account number ${inv.bank.accountNumber}`,
          '',
          inv.terms,
          '',
          inv.signOff,
          inv.signatory,
          inv.tradingName,
        ].join('\n');
        const mailto = `mailto:${encodeURIComponent(d.clientEmail)}?subject=${encodeURIComponent(
          `Invoice ${d.number} from ${inv.tradingName}`
        )}&body=${encodeURIComponent(lines)}`;
        window.location.href = mailto;
        setNote('PDF downloaded and your email opened. Attach the PDF, then send. Saved to Records.');
      }

      function setNote(text: string) {
        document.querySelectorAll('.send-note').forEach((n) => {
          n.textContent = text;
          (n as HTMLElement).classList.remove('hidden');
        });
      }

      // ---------- Wire up ----------
      function addRow(r?: Row) {
        const i = els.rows().querySelectorAll('.row').length;
        els.rows().insertAdjacentHTML('beforeend', rowHtml(r || { productType: '', description: '', unit: '', price: '' }, i));
        bindRow(els.rows().lastElementChild as HTMLElement);
        renderPreview();
      }
      function bindRow(el: HTMLElement) {
        el.querySelectorAll('input,textarea').forEach((inp) =>
          inp.addEventListener('input', () => { renderPreview(); saveDraft(); })
        );
        el.querySelector('.del-row')!.addEventListener('click', () => {
          el.remove();
          renderPreview();
          saveDraft();
        });
      }

      function loadDraft() {
        const raw = localStorage.getItem(DRAFT);
        if (!raw) return false;
        try {
          const d = JSON.parse(raw);
          els.number().value = d.number || genNumber();
          els.date().value = d.dateISO || todayISO();
          els.client().value = d.clientName || '';
          els.address().value = d.clientAddress || '';
          els.email().value = d.clientEmail || '';
          els.notes().value = d.notes || '';
          els.rows().innerHTML = '';
          (d._rows && d._rows.length ? d._rows : [{ productType: '', description: '', unit: '', price: '' }]).forEach((r: Row) => addRow(r));
          return true;
        } catch {
          return false;
        }
      }

      function invSeqFromNumber(number: string): number {
        const n = parseInt(String(number).split('-').pop() || '', 10);
        return Number.isFinite(n) ? n : 0;
      }
      /** Mark a sequence as used so the next generated number moves on. */
      function markUsed(number: string) {
        const seq = invSeqFromNumber(number);
        const stored = parseInt(localStorage.getItem(SEQ) || '0', 10) || 0;
        if (seq > stored) localStorage.setItem(SEQ, String(seq));
      }

      function freshInvoice() {
        markUsed(els.number().value); // consume the current number
        localStorage.removeItem(DRAFT);
        els.number().value = genNumber();
        els.date().value = todayISO();
        els.client().value = '';
        els.address().value = '';
        els.email().value = '';
        els.notes().value = '';
        els.rows().innerHTML = '';
        addRow();
        addRow();
        renderPreview();
      }

      // ---------- Records (saved invoices + payments) ----------
      // Held in memory (recordsCache), mirrored to localStorage, and synced to
      // Supabase when the owner is signed in to the cloud (cloudMode).
      let recordsCache: any[] = [];

      function localRecords(): any[] {
        try { return JSON.parse(localStorage.getItem(RECORDS) || '[]'); } catch { return []; }
      }
      function setLocalRecords(a: any[]) { localStorage.setItem(RECORDS, JSON.stringify(a)); }

      function localUpsert(rec: any) {
        const arr = localRecords();
        const fields = { number: rec.number, dateISO: rec.dateISO, clientName: rec.clientName, clientAddress: rec.clientAddress, email: rec.email, total: rec.total, items: rec.items, notes: rec.notes };
        const i = arr.findIndex((r) => r.number === rec.number);
        if (i >= 0) arr[i] = { ...arr[i], ...fields };
        else arr.push({ ...fields, status: 'sent', paidDateISO: '' });
        setLocalRecords(arr);
      }

      // The address is packed into the jsonb `items` column as { lines, address }
      // so we can restore a full invoice with no database schema change.
      function dbToApp(r: any) {
        const bundle = r.items;
        const lines = Array.isArray(bundle) ? bundle : bundle && bundle.lines ? bundle.lines : [];
        const address = bundle && !Array.isArray(bundle) && bundle.address ? bundle.address : '';
        return { number: r.number, dateISO: r.date || '', clientName: r.client_name || '', clientAddress: address, email: r.email || '', total: Number(r.total) || 0, status: r.status || 'sent', paidDateISO: r.paid_date || '', items: lines, notes: r.notes || '' };
      }
      function packItems(rec: any) {
        return { lines: rec.items || [], address: rec.clientAddress || '' };
      }

      async function insertMissing(rec: any) {
        const base: any = { number: rec.number, date: rec.dateISO || null, client_name: rec.clientName, email: rec.email, total: rec.total, items: packItems(rec), notes: rec.notes || null, status: rec.status || 'sent', paid_date: rec.paidDateISO || null };
        await supabase!.from('invoices').insert(base);
      }

      async function loadRecords() {
        if (cloudMode && supabase) {
          try {
            const { data: cloudData, error } = await supabase.from('invoices').select('*');
            if (!error) {
              // Push any on-device invoices the cloud doesn't have yet (safe: never deletes).
              const cloudNums = new Set((cloudData || []).map((r: any) => r.number));
              const missing = localRecords().filter((r: any) => r.number && !cloudNums.has(r.number));
              for (const rec of missing) { try { await insertMissing(rec); } catch {} }
              const fresh = missing.length ? (await supabase.from('invoices').select('*')).data : cloudData;
              recordsCache = (fresh || []).map(dbToApp);
              setLocalRecords(recordsCache);
              renderRecords();
              return;
            }
          } catch {}
        }
        recordsCache = localRecords();
        renderRecords();
      }

      async function saveRecord(d: any) {
        const rec = { number: d.number, dateISO: d.dateISO, clientName: d.clientName, clientAddress: d.clientAddress, email: d.clientEmail, total: invoiceTotal(d.items), items: d.items, notes: d.notes };
        localUpsert(rec);
        markUsed(d.number);
        if (cloudMode && supabase) {
          try {
            const base: any = { number: rec.number, date: rec.dateISO || null, client_name: rec.clientName, email: rec.email, total: rec.total, items: packItems(rec), notes: rec.notes };
            const { data: ex } = await supabase.from('invoices').select('id').eq('number', rec.number).maybeSingle();
            if (ex) await supabase.from('invoices').update(base).eq('id', ex.id);
            else await supabase.from('invoices').insert({ ...base, status: 'sent', paid_date: null });
          } catch (e) { console.warn('Cloud save failed; kept on device.', e); }
        }
        await loadRecords();
      }

      async function setPaid(number: string, paid: boolean) {
        const arr = localRecords();
        const r = arr.find((x) => x.number === number);
        if (r) { r.status = paid ? 'paid' : 'sent'; r.paidDateISO = paid ? todayISO() : ''; setLocalRecords(arr); }
        if (cloudMode && supabase) {
          try { await supabase.from('invoices').update({ status: paid ? 'paid' : 'sent', paid_date: paid ? todayISO() : null }).eq('number', number); } catch {}
        }
        await loadRecords();
      }

      async function deleteRecord(number: string) {
        if (!confirm('Delete invoice ' + number + ' from your records?')) return;
        setLocalRecords(localRecords().filter((x) => x.number !== number));
        if (cloudMode && supabase) { try { await supabase.from('invoices').delete().eq('number', number); } catch {} }
        await loadRecords();
      }

      async function pushLocalToCloud() {
        if (!(cloudMode && supabase)) { alert('Cloud sync is off. Log in with your Supabase passcode first.'); return; }
        await loadRecords(); // loadRecords() pushes any device-only invoices to the cloud
        alert('Your device records are synced to the cloud.');
      }

      function groupTotals(recs: any[], keyFn: (r: any) => string) {
        const map: Record<string, { invoiced: number; paid: number }> = {};
        recs.forEach((r) => {
          const k = keyFn(r);
          if (!k) return;
          if (!map[k]) map[k] = { invoiced: 0, paid: 0 };
          map[k].invoiced += r.total || 0;
          if (r.status === 'paid') map[k].paid += r.total || 0;
        });
        return map;
      }
      const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      function monthLabel(k: string) {
        const [y, m] = k.split('-');
        return `${MONTHS[parseInt(m, 10) - 1]} ${y}`;
      }

      function renderRecords() {
        const status = document.getElementById('rec-status');
        if (status) status.textContent = cloudMode ? 'Cloud sync on. Synced across your devices.' : (supabase ? 'On this device only. Log in with your Supabase passcode to sync.' : 'Saved on this device.');
        const recs = recordsCache.slice().sort((a, b) => (a.dateISO < b.dateISO ? 1 : -1));
        const invoiced = recs.reduce((s, r) => s + (r.total || 0), 0);
        const paid = recs.filter((r) => r.status === 'paid').reduce((s, r) => s + (r.total || 0), 0);
        const outstanding = invoiced - paid;

        const summary = document.getElementById('rec-summary');
        if (summary) {
          const card = (label: string, value: string, color: string) =>
            `<div class="rounded-2xl bg-white p-5 shadow-card"><div class="text-sm font-semibold text-[#5b6b7f]">${label}</div><div class="mt-1 text-3xl font-extrabold" style="color:${color}">${value}</div></div>`;
          summary.innerHTML =
            card('Invoiced', formatGBP(invoiced), '#152437') +
            card('Paid', formatGBP(paid), '#16a34a') +
            card('Outstanding', formatGBP(outstanding), '#e11d2a');
        }

        const years = groupTotals(recs, (r) => (r.dateISO || '').slice(0, 4));
        const yearsEl = document.getElementById('rec-years');
        if (yearsEl) {
          const rows = Object.keys(years).sort().reverse().map((y) => {
            const g = years[y];
            return `<tr style="border-bottom:1px solid #f0f3f7;"><td style="padding:8px 10px;font-weight:700;">${y}</td><td style="padding:8px 10px;text-align:right;">${formatGBP(g.invoiced)}</td><td style="padding:8px 10px;text-align:right;color:#16a34a;">${formatGBP(g.paid)}</td><td style="padding:8px 10px;text-align:right;color:#e11d2a;">${formatGBP(g.invoiced - g.paid)}</td></tr>`;
          }).join('');
          yearsEl.innerHTML = rows ? recTable(rows, ['Year', 'Invoiced', 'Paid', 'Outstanding']) : '<p class="text-sm text-[#5b6b7f]">No invoices yet.</p>';
        }

        const months = groupTotals(recs, (r) => (r.dateISO || '').slice(0, 7));
        const monthsEl = document.getElementById('rec-months');
        if (monthsEl) {
          const rows = Object.keys(months).sort().reverse().slice(0, 12).map((k) => {
            const g = months[k];
            return `<tr style="border-bottom:1px solid #f0f3f7;"><td style="padding:8px 10px;font-weight:700;">${monthLabel(k)}</td><td style="padding:8px 10px;text-align:right;">${formatGBP(g.invoiced)}</td><td style="padding:8px 10px;text-align:right;color:#16a34a;">${formatGBP(g.paid)}</td><td style="padding:8px 10px;text-align:right;color:#e11d2a;">${formatGBP(g.invoiced - g.paid)}</td></tr>`;
          }).join('');
          monthsEl.innerHTML = rows ? recTable(rows, ['Month', 'Invoiced', 'Paid', 'Outstanding']) : '<p class="text-sm text-[#5b6b7f]">No invoices yet.</p>';
        }

        renderRecordsList();
      }

      function recTable(rows: string, headers: string[]) {
        return `<table style="width:100%;border-collapse:collapse;font-size:14px;min-width:340px;">
            <thead><tr style="text-align:left;color:#5b6b7f;border-bottom:2px solid #e7edf4;">
              ${headers.map((h, i) => `<th style="padding:8px 10px;${i ? 'text-align:right;' : ''}">${h}</th>`).join('')}
            </tr></thead><tbody>${rows}</tbody></table>`;
      }

      // Filter state for the invoice list (search + status).
      const recFilter = { q: '', status: 'all' };

      function renderRecordsList() {
        const listEl = document.getElementById('rec-list');
        if (!listEl) return;
        const q = recFilter.q.trim().toLowerCase();
        let recs = recordsCache.slice().sort((a, b) => (a.dateISO < b.dateISO ? 1 : -1));
        if (recFilter.status !== 'all') recs = recs.filter((r) => (r.status || 'sent') === recFilter.status);
        if (q) recs = recs.filter((r) => (r.clientName || '').toLowerCase().includes(q) || (r.number || '').toLowerCase().includes(q));

        if (!recordsCache.length) {
          listEl.innerHTML = '<p class="text-sm text-[#5b6b7f]">No invoices saved yet. Download or send an invoice and it will appear here.</p>';
          return;
        }
        if (!recs.length) {
          listEl.innerHTML = '<p class="text-sm text-[#5b6b7f]">No invoices match your search.</p>';
          return;
        }
        const rows = recs.map((r) => {
          const badge = r.status === 'paid'
            ? '<span style="background:#dcfce7;color:#166534;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:700;">Paid</span>'
            : '<span style="background:#fee2e2;color:#991b1b;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:700;">Unpaid</span>';
          const toggle = r.status === 'paid'
            ? `<button data-unpaid="${r.number}" style="color:#5b6b7f;font-weight:600;">Unpaid</button>`
            : `<button data-paid="${r.number}" style="color:#16a34a;font-weight:700;">Paid</button>`;
          return `<tr style="border-bottom:1px solid #f0f3f7;">
            <td style="padding:9px 10px;white-space:nowrap;">${formatDateUK(r.dateISO)}</td>
            <td style="padding:9px 10px;font-weight:700;white-space:nowrap;">${escapeHtml(r.number)}</td>
            <td style="padding:9px 10px;">${escapeHtml(r.clientName || '')}</td>
            <td style="padding:9px 10px;text-align:right;white-space:nowrap;font-weight:700;">${formatGBP(r.total)}</td>
            <td style="padding:9px 10px;text-align:center;">${badge}</td>
            <td style="padding:9px 10px;text-align:right;white-space:nowrap;">
              <button data-open="${r.number}" style="color:#1863dc;font-weight:700;">Open</button> &nbsp;
              <button data-copy="${r.number}" style="color:#1863dc;font-weight:600;">Copy</button> &nbsp;
              ${toggle} &nbsp;
              <button data-del="${r.number}" style="color:#e11d2a;font-weight:600;">Delete</button>
            </td>
          </tr>`;
        }).join('');
        listEl.innerHTML = recTable(rows, ['Date', 'Invoice', 'Client', 'Amount', 'Status', '']);
        listEl.querySelectorAll('[data-paid]').forEach((b) => b.addEventListener('click', () => setPaid((b as HTMLElement).dataset.paid!, true)));
        listEl.querySelectorAll('[data-unpaid]').forEach((b) => b.addEventListener('click', () => setPaid((b as HTMLElement).dataset.unpaid!, false)));
        listEl.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', () => deleteRecord((b as HTMLElement).dataset.del!)));
        listEl.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('click', () => openRecord((b as HTMLElement).dataset.open!, false)));
        listEl.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', () => openRecord((b as HTMLElement).dataset.copy!, true)));
      }

      // Reopen a saved invoice into the builder. duplicate=true gives it a new number.
      function openRecord(number: string, duplicate: boolean) {
        const rec = recordsCache.find((r) => r.number === number);
        if (!rec) return;
        els.number().value = duplicate ? genNumber() : rec.number;
        els.date().value = duplicate ? todayISO() : rec.dateISO || todayISO();
        els.client().value = rec.clientName || '';
        els.address().value = rec.clientAddress || '';
        els.email().value = rec.email || '';
        els.notes().value = rec.notes || '';
        els.rows().innerHTML = '';
        const lines = rec.items && rec.items.length ? rec.items : [{}];
        lines.forEach((it: any) => addRow({ productType: it.productType || '', description: it.description || '', unit: it.unit != null ? String(it.unit) : '', price: it.price != null ? String(it.price) : '' }));
        saveDraft();
        renderPreview();
        switchScreen('builder');
        switchTab('edit');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      // ---------- Screen + tab switching ----------
      function switchScreen(name: string) {
        const builder = document.getElementById('builder-screen')!;
        const records = document.getElementById('records-screen')!;
        const isRec = name === 'records';
        builder.classList.toggle('hidden', isRec);
        records.classList.toggle('hidden', !isRec);
        document.querySelectorAll('.screenbtn').forEach((b) =>
          b.setAttribute('aria-selected', String((b as HTMLElement).dataset.screen === name))
        );
        if (isRec) renderRecords();
        else fitPreview();
      }
      function switchTab(name: string) {
        const edit = document.getElementById('edit-pane')!;
        const prev = document.getElementById('preview-pane')!;
        const isPrev = name === 'preview';
        edit.classList.toggle('hidden', isPrev);
        prev.classList.toggle('hidden', !isPrev);
        document.querySelectorAll('.tabbtn').forEach((b) =>
          b.setAttribute('aria-selected', String((b as HTMLElement).dataset.tab === name))
        );
        if (isPrev) requestAnimationFrame(fitPreview);
      }

      function exportRecords() {
        const blob = new Blob([JSON.stringify(loadRecords(), null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'ultra-doors-invoices-backup.json';
        a.click();
        URL.revokeObjectURL(url);
      }
      function importRecords(file: File) {
        const r = new FileReader();
        r.onload = () => {
          try {
            const arr = JSON.parse(String(r.result));
            if (Array.isArray(arr)) { saveRecords(arr); renderRecords(); alert('Restored ' + arr.length + ' invoices.'); }
            else alert('That file does not look like a backup.');
          } catch { alert('Could not read that file.'); }
        };
        r.readAsText(file);
      }

      let inited = false;
      function init() {
        if (inited) return;
        inited = true;
        [els.number(), els.date(), els.client(), els.address(), els.email(), els.notes()].forEach((el) =>
          el.addEventListener('input', () => { renderPreview(); saveDraft(); })
        );
        document.getElementById('add-row')!.addEventListener('click', () => { addRow(); saveDraft(); });

        document.querySelectorAll('[data-act="pdf"]').forEach((b) => b.addEventListener('click', () => downloadPdf()));
        document.querySelectorAll('[data-act="print"]').forEach((b) => b.addEventListener('click', () => window.print()));
        document.querySelectorAll('[data-act="send"]').forEach((b) => b.addEventListener('click', () => sendToClient()));
        document.querySelectorAll('[data-act="new"]').forEach((b) =>
          b.addEventListener('click', () => { if (confirm('Start a new blank invoice? The current draft will be cleared.')) freshInvoice(); })
        );

        document.querySelectorAll('.tabbtn').forEach((b) => b.addEventListener('click', () => switchTab((b as HTMLElement).dataset.tab!)));
        document.querySelectorAll('.screenbtn').forEach((b) => b.addEventListener('click', () => switchScreen((b as HTMLElement).dataset.screen!)));

        document.getElementById('rec-export')!.addEventListener('click', exportRecords);
        document.getElementById('rec-import')!.addEventListener('click', () => document.getElementById('rec-file')!.click());
        document.getElementById('rec-file')!.addEventListener('change', (e) => {
          const f = (e.target as HTMLInputElement).files?.[0];
          if (f) importRecords(f);
        });
        document.getElementById('rec-sync')!.addEventListener('click', () => pushLocalToCloud());
        document.getElementById('rec-search')!.addEventListener('input', (e) => { recFilter.q = (e.target as HTMLInputElement).value; renderRecordsList(); });
        document.getElementById('rec-filter-status')!.addEventListener('change', (e) => { recFilter.status = (e.target as HTMLSelectElement).value; renderRecordsList(); });

        // Re-fit the preview whenever its container changes size, including
        // when the Preview tab first becomes visible on mobile (0 -> width).
        const scalerEl = els.preview().parentElement as HTMLElement;
        if (typeof ResizeObserver !== 'undefined' && scalerEl) {
          new ResizeObserver(() => fitPreview()).observe(scalerEl);
        }

        if (!loadDraft()) freshInvoice();
        switchTab('edit');
        switchScreen('builder');
        renderPreview();
      }

      // Helpers
      function escapeHtml(s: string) {
        return (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
      }
      function escapeAttr(s: string) {
        return escapeHtml(s).replace(/"/g, '&quot;');
      }
    </script>
  </body>
</html>
