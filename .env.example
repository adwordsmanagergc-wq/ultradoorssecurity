# Copy to `.env` for local dev, and set the same variable in your Vercel
# project (Settings → Environment Variables). Must be prefixed PUBLIC_ so
# Astro exposes it to the browser.

# Formspree form endpoint for the contact / quote form.
# 1. Create a free form at https://formspree.io
# 2. Paste its endpoint here (looks like https://formspree.io/f/xxxxxxxx)
# Without it, the form falls back to opening the visitor's email client.
PUBLIC_FORMSPREE_ENDPOINT=
